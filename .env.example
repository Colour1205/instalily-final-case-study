# Copy this file to .env and fill in your own values. Never commit .env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=leads
# Leave empty when there is no read replica (reads then go to the primary).
POSTGRES_REPLICA_HOST=

REDIS_URL=redis://localhost:6379/0

# Which AI writes the analyses (see the README). The default, lili-analyst, is a private model, so remove the #
# in front of ONE of these two choices:
# Claude:
# AI_PROVIDER=claude
# AI_MODEL=claude-haiku-5-5
# Ollama on this computer (after: ollama pull qwen3:1.7b):
# AI_PROVIDER=ollama
# AI_MODEL=qwen3:1.7b
# OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
